# Backend (FastAPI) environment variables.
# Copy to .env for local use, or set each one in the Render dashboard.
# Never commit real values -- this file is an example only.

# --- Authentication ---------------------------------------------------------------
# Bearer token registry as inline JSON. Takes precedence over the on-disk registry at
# backend/data/auth/api_tokens.json, which is gitignored. Generate both with:
#   python scripts/generate_api_tokens.py
# The script prints each raw token exactly once -- the frontend needs it as GIS_API_TOKEN.
GIS_API_TOKENS=

# Auth mode. "token" (default) requires a bearer token and fails closed.
# "disabled" grants every request the GIS admin role -- local development only,
# never in a deployment.
GIS_AUTH_MODE=token

# --- CORS -------------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API. Whitespace around each
# entry is stripped. Defaults to the two local dev origins when unset, so local work
# needs no configuration. In a deployment set this to the frontend's own origin:
#   CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Writable paths ---------------------------------------------------------------
# Both default to paths inside backend/ and their parent directories are created on
# startup. Override them when the platform provides a mounted disk elsewhere.
# SAVED_ANALYSES_DB=/var/data/saved_analyses.db
# UPLOAD_DIR=/var/data/uploads/projects

# --- SLA escalation (MSG91 SMS) ---------------------------------------------------
# Delivery is off unless MSG91_ENABLED is exactly "true". With it false the SLA panel
# still composes and previews the alert; nothing is dispatched.
MSG91_ENABLED=false

# MSG91 account credentials, from the MSG91 dashboard.
MSG91_AUTH_KEY=
# Approved DLT flow/template id the alert is sent through.
MSG91_TEMPLATE_ID=
# Registered sender id shown to the recipient.
MSG91_SENDER_ID=
# Destination number for escalations, with country code and no "+".
MINISTRY_ALERT_PHONE=
