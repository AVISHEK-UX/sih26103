# Frontend (Next.js) environment variables.
# Copy to .env.local for local use, or set each one in the Vercel dashboard
# under Settings -> Environment Variables. Never commit real values.

# --- Backend URL, browser-visible -------------------------------------------------
# Base URL of the FastAPI backend, no trailing slash. NEXT_PUBLIC_* variables are
# inlined into the client bundle at build time, so this is readable by every visitor
# and must never hold a secret. Changing it requires a rebuild, not just a restart.
# Defaults to http://127.0.0.1:8000 when unset, which is what local development wants.
NEXT_PUBLIC_API_URL=https://pragukti-api.onrender.com

# --- GIS proxy, server-only -------------------------------------------------------
# Used only by the server-side route at src/app/api/gis/[...path]/route.ts, which
# forwards browser requests to the backend's token-protected GIS endpoints. Neither
# of these reaches the browser.

# Backend URL the proxy forwards to. Usually the same as NEXT_PUBLIC_API_URL.
# Defaults to http://127.0.0.1:8000 when unset.
GIS_API_URL=https://pragukti-api.onrender.com

# Raw bearer token printed once by backend/scripts/generate_api_tokens.py. It must
# correspond to an entry in the backend's GIS_API_TOKENS registry. Without it the
# proxy still forwards, and the backend answers 401 explaining what is missing.
GIS_API_TOKEN=
