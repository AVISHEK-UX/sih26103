# Frontend (Vercel) environment variables.
# Set both in the Vercel dashboard: Project -> Settings -> Environment Variables.

# Public URL of the deployed backend, no trailing slash.
NEXT_PUBLIC_API_URL=https://pragukti-api.onrender.com

# Bearer token for the GIS proxy routes (src/app/api/gis/[...path]/route.ts).
# This is held server-side and never reaches the browser. Generate it with:
#   cd backend && python scripts/generate_api_tokens.py
GIS_API_TOKEN=
